<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GhostRdp.Setup</AssemblyName>
    <RootNamespace>GhostRdp.Setup</RootNamespace>
    <Product>Ghost RDP Setup</Product>
    <Title>Ghost RDP Setup</Title>
    <Description>Per-user Windows installer for Ghost RDP.</Description>
    <Version>0.9.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup Condition="'$(PayloadZip)' != '' and Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="GhostRdp.Setup.Payload.zip" />
  </ItemGroup>
</Project>
