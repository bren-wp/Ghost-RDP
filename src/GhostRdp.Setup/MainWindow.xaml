<Window x:Class="GhostRdp.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghost RDP Setup"
        Width="680"
        Height="470"
        MinWidth="620"
        MinHeight="430"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PanelAltBrush}" Margin="0,0,14,0">
                    <Viewbox Margin="9">
                        <Path Fill="{StaticResource AccentStrongBrush}"
                              Data="M2,4 C2,2.9 2.9,2 4,2 H20 C21.1,2 22,2.9 22,4 V16 C22,17.1 21.1,18 20,18 H14 V20 H18 V22 H6 V20 H10 V18 H4 C2.9,18 2,17.1 2,16 Z M5,5 V15 H19 V5 Z" />
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Ghost RDP" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="30" FontWeight="SemiBold" Margin="0,30,0,0" />
            <TextBlock x:Name="DescriptionText" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,24,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Architecture" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock x:Name="ArchitectureText" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Installation folder" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock x:Name="InstallPathText" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <CheckBox x:Name="RemoveDataCheckBox" Visibility="Collapsed">
                <TextBlock Text="Also remove saved computers and local Ghost RDP settings" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock x:Name="DataNoticeText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <ProgressBar x:Name="ProgressBar" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,20,0,0" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LaunchButton" Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Launch Ghost RDP" HorizontalAlignment="Left" Visibility="Collapsed" Click="LaunchButton_Click" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Close" MinWidth="96" Click="CloseButton_Click" />
            <Button x:Name="PrimaryButton" Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170" Click="PrimaryButton_Click" />
        </Grid>
    </Grid>
</Window>
