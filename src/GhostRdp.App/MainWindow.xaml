<Window x:Class="GhostRdp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghost RDP"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,8,6,28">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SelectionBrush}" Margin="0,0,10,0">
                            <Viewbox Margin="7">
                                <Path Fill="{StaticResource AccentStrongBrush}" Data="M2,4 C2,2.9 2.9,2 4,2 H20 C21.1,2 22,2.9 22,4 V16 C22,17.1 21.1,18 20,18 H14 V20 H18 V22 H6 V20 H10 V18 H4 C2.9,18 2,17.1 2,16 Z M5,5 V15 H19 V5 Z M8,8 C8,6.9 8.9,6 10,6 H14 C15.1,6 16,6.9 16,8 V12 H14.5 V10.5 H9.5 V12 H8 Z" />
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ghost RDP" FontWeight="SemiBold" FontSize="17" />
                            <TextBlock Text="Windows MVP" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="NAVIGATION" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,8" />
                    <Button x:Name="HomeNavButton" Style="{StaticResource SidebarButtonStyle}" Click="HomeNavButton_Click" Content="Home" />
                    <Button x:Name="AboutNavButton" Style="{StaticResource SidebarButtonStyle}" Click="AboutNavButton_Click" Content="About" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelAltBrush}" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Privacy first" FontWeight="SemiBold" />
                        <TextBlock Text="No telemetry or analytics." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="38,32">
            <Grid x:Name="HomeView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Home" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Secure remote desktop management foundation." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,6,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Microsoft RDP runtime" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="RuntimeStatusText" Text="Checking..." FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock x:Name="RuntimeDetailText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Refresh status" HorizontalAlignment="Left" Margin="0,18,0,0" Click="RefreshStatusButton_Click" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Security baseline" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock Text="Credential-safe by design" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Passwords are not persisted by the initial architecture and are never passed through command-line arguments." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,20,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Initial foundation" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="This build exposes only features that are implemented. Saved computers, Quick Connect, sessions, favorites, and advanced host readiness are intentionally absent until their milestones provide real runtime behavior." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="AboutView" Visibility="Collapsed">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="About Ghost RDP" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="AboutText" Foreground="{StaticResource MutedBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,16,0,0" />
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="Security model" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Ghost RDP does not open router ports, disable Windows Firewall, disable NLA, bypass UAC, or hide background access. Remote-access transport features must use explicit, reviewable security boundaries." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
