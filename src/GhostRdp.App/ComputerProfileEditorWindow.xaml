<Window x:Class="GhostRdp.App.ComputerProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computer profile"
        Width="680"
        Height="820"
        MinWidth="620"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="Computer profile" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Connection metadata is stored locally. Passwords are not part of the profile schema."
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,18">
            <StackPanel>
                <TextBlock Text="Display name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="DisplayNameTextBox" MaxLength="100" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Host / IP" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="HostTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="PortTextBox" Text="3389" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Username" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="UsernameTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Domain" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="DomainTextBox" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Remote access route" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6" />
                <ComboBox x:Name="RemoteAccessModeComboBox" SelectedIndex="0">
                    <ComboBoxItem Content="Direct / LAN" />
                    <ComboBoxItem Content="Private VPN / overlay" />
                    <ComboBoxItem Content="RD Gateway" />
                </ComboBox>
                <TextBlock Text="Private-network mode assumes your VPN or overlay is already connected. Ghost RDP does not configure VPNs or router ports."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />

                <TextBlock Text="RD Gateway host" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,6" />
                <TextBox x:Name="GatewayHostTextBox" ToolTip="Required only when RD Gateway route is selected" />
                <TextBlock Text="When RD Gateway is selected, Ghost RDP writes only the gateway hostname and safe routing settings to the temporary .rdp file. Credentials remain owned by Windows."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />

                <TextBlock Text="Tags (comma separated)" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,6" />
                <TextBox x:Name="TagsTextBox" />

                <TextBlock Text="Notes" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,6" />
                <TextBox x:Name="NotesTextBox"
                         Height="92"
                         MaxLength="4000"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <CheckBox x:Name="FavoriteCheckBox" Content="Favorite computer" Margin="0,18,0,0" />
                <TextBlock x:Name="ValidationText"
                           Foreground="{StaticResource DangerBrush}"
                           Margin="0,14,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save computer" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
