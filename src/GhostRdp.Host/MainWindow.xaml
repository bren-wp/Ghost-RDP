<Window x:Class="GhostRdp.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghost RDP Host"
        Width="1120"
        Height="800"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="30,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource SelectionBrush}" Margin="0,0,12,0">
                        <Viewbox Margin="8">
                            <Path Fill="{StaticResource AccentStrongBrush}"
                                  Data="M2,4 C2,2.9 2.9,2 4,2 H20 C21.1,2 22,2.9 22,4 V16 C22,17.1 21.1,18 20,18 H14 V20 H18 V22 H6 V20 H10 V18 H4 C2.9,18 2,17.1 2,16 Z M5,5 V15 H19 V5 Z M8,8 C8,6.9 8.9,6 10,6 H14 C15.1,6 16,6.9 16,8 V12 H14.5 V10.5 H9.5 V12 H8 Z" />
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ghost RDP Host" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Read-only Windows Remote Desktop readiness diagnostics"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LastCheckedText"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="Refresh diagnostics"
                            Click="RefreshDiagnosticsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="30,26,30,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ReadinessAccentBorder"
                                Grid.Column="0"
                                Background="{StaticResource MutedBrush}"
                                CornerRadius="4" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="HOST READINESS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReadinessTitleText"
                                       Text="Checking Windows diagnostics..."
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Margin="0,7,0,0" />
                            <TextBlock x:Name="ReadinessDetailText"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       MaxWidth="760" />
                        </StackPanel>
                        <Border Grid.Column="3"
                                Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,7"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="ReadinessBadgeText" Text="UNKNOWN" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="System" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
                            <TextBlock Text="Computer name" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="ComputerNameText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Hostname" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="HostnameText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Windows edition" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="WindowsEditionText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Version / build" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="WindowsVersionText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Current user" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="CurrentUserText" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="Remote Desktop" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
                            <TextBlock Text="Incoming RDP support" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="EditionSupportText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Remote Desktop configuration" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="RdpEnabledText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Remote Desktop Services" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="RdpServiceText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="RDP port" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="RdpPortText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Network Level Authentication" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="NlaText" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="Firewall and network profile" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
                            <TextBlock Text="Windows Firewall" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="FirewallEnabledText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Block all inbound" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="FirewallBlockAllText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Inbound RDP rule" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="FirewallInboundText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,14" />
                            <TextBlock Text="Active profiles" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="NetworkProfilesText" Style="{StaticResource ValueTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="Addresses and private-network indicators" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
                            <TextBlock Text="LAN addresses" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="LanAddressesText" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,18" />
                            <TextBlock Text="VPN / private overlay adapters" Style="{StaticResource LabelTextStyle}" />
                            <TextBlock x:Name="PrivateNetworkText" Style="{StaticResource ValueTextStyle}" />
                            <TextBlock Text="Adapter detection is an indicator only; it does not prove that a secure remote route is currently usable."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Diagnostic notes" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiagnosticsText"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                        <TextBlock Text="Read-only mode: Ghost RDP Host does not enable Remote Desktop, start services, open firewall rules, change NLA, or modify router/network exposure."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
