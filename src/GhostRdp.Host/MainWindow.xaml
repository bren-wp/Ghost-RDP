<Window x:Class="GhostRdp.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghost RDP Host"
        Width="720"
        Height="500"
        MinWidth="640"
        MinHeight="440"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <StackPanel>
            <TextBlock Text="Ghost RDP Host" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Visible host identity foundation" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,24" />

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Computer name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />
                    <TextBlock x:Name="ComputerNameText" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,0,14" />

                    <TextBlock Grid.Row="1" Text="Windows" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />
                    <TextBlock x:Name="OperatingSystemText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <TextBlock Grid.Row="2" Text="Current user" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="CurrentUserText" Grid.Row="2" Grid.Column="1" />
                </Grid>
            </Border>

            <TextBlock Text="This milestone does not claim RDP readiness, firewall state, NLA state, or VPN state. Those checks are added only when backed by real Windows diagnostics." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</Window>
