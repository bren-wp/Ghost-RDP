<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GhostRdp.Host</AssemblyName>
    <RootNamespace>GhostRdp.Host</RootNamespace>
    <Product>Ghost RDP Host</Product>
    <Title>Ghost RDP Host</Title>
    <Description>Read-only Windows Remote Desktop readiness diagnostics for computers you control.</Description>
    <Version>0.9.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GhostRdp.Core\GhostRdp.Core.csproj" />
  </ItemGroup>
</Project>
